# ==============================================================================
# Gulf HR Enterprise - Production Apache Configuration for hr.trackmyteam.us
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass Authorization Header to PHP in FastCGI / CGI / PHP-FPM mode
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # Prevent loop if already rewritten
    RewriteCond %{ENV:REDIRECT_STATUS} 200
    RewriteRule ^ - [L]

    # 1. API Calls: Route to /api/index.php and stop rewrite
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]
    RewriteRule ^api$ api/index.php [QSA,L]

    # 2. Card Bridge Driver Direct Download
    RewriteRule ^downloads/SaNDSLabCardBridge\.zip$ download_bridge.php [L]
    RewriteRule ^download_bridge\.php$ download_bridge.php [L]

    # 3. Backend direct access: Stop rewrite
    RewriteRule ^backend/ - [L]

    # 3. Allow direct access to uploaded documents
    RewriteRule ^uploads/(.*)$ backend/public/uploads/$1 [L]

    # 4. Serve existing physical files & directories directly (JS, CSS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Route all frontend pages to index.html (EXCLUDE /api and /backend)
    RewriteCond %{REQUEST_URI} !^/api
    RewriteCond %{REQUEST_URI} !^/backend
    RewriteRule ^ index.html [L]
</IfModule>

# Disable Directory Browsing
Options -Indexes

# Security: Block direct access to sensitive backend files
<FilesMatch "(^\.env|\.sql|Config\.php|seeder\.php|\.git)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>
