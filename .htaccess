# ==============================================================================
# Gulf HR Enterprise - Production Apache Configuration for hr.trackmyteam.us
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Route API requests to PHP Backend
    RewriteRule ^api/(.*)$ backend/public/index.php [QSA,L]
    RewriteRule ^api$ backend/public/index.php [QSA,L]

    # 2. Allow direct access to uploaded files
    RewriteRule ^uploads/(.*)$ backend/public/uploads/$1 [L]

    # 3. Serve existing static files & directories directly (JS, CSS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Route all frontend URLs to index.html (React Single Page App)
    RewriteRule ^ index.html [L]
</IfModule>

# Disable Directory Browsing
Options -Indexes

# Security: Block direct access to sensitive backend files
<FilesMatch "(^\.env|\.sql|Config\.php|seeder\.php|\.git)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable GZIP Compression for ultra-fast loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>
